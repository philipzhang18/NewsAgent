# OpenAI API Configuration (supports OpenAI-compatible endpoints like Alibaba Cloud)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# News API Keys
NEWS_API_KEY=your_newsapi_key_here
GUARDIAN_API_KEY=your_guardian_api_key_here
NYTIMES_API_KEY=your_nytimes_api_key_here

# Social Media API Keys
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=python:newsagent:v1.0.0 (by /u/your_username)

# Local SQLite storage (default path)
SQLITE_DB_PATH=data/news_articles.db

# Application Settings
FLASK_SECRET_KEY=your_flask_secret_key_here
DEBUG=False
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en

# News Collection Settings
COLLECTION_INTERVAL=300
MAX_ARTICLES_PER_SOURCE=100
ENABLE_SENTIMENT_ANALYSIS=True
ENABLE_BIAS_DETECTION=True

# RSS Feed Sources (comma-separated)
RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://rss.cnn.com/rss/edition.rss

# Web Scraping Settings
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
REQUEST_TIMEOUT=30
REQUEST_TIMEOUT=30
MAX_RETRIES=3
MAX_PROCESS_PER_COLLECTION=30
